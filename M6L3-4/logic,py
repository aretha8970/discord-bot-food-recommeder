BASE_DIR = os.path.dirname(os.path.abspath(__file__))
DB_PATH = os.path.join(BASE_DIR, "makanan.db")

# Tag mengikuti resep umum; pengguna tetap perlu memeriksa bahan makanan.
ALERGENS = {"susu", "telur", "kacang", "kedelai", "gluten", "ikan", "udang"}


def initialize_allergen_data():
    """Menambahkan data alergen pada basis data lama tanpa menghapus makanan."""
    con = sqlite3.connect(DB_PATH)
    try:
        cur = con.cursor()
        columns = {row[1] for row in cur.execute("PRAGMA table_info(makanan)")}
        if "alergen" not in columns:
            cur.execute("ALTER TABLE makanan ADD COLUMN alergen TEXT NOT NULL DEFAULT ''")

        tags = {
            "Nasi uduk": "susu", "Nasi kuning": "susu", "Mie goreng": "gluten;telur",
            "Mie rebus": "gluten;telur", "Gado-gado": "kacang", "Pecel": "kacang",
            "Karedok": "kacang", "Ikan bakar": "ikan", "Ikan asam manis": "ikan",
            "Ikan goreng": "ikan", "Pepes ikan": "ikan", "Telur rebus": "telur",
            "Telur dadar": "telur", "Tempe goreng": "kedelai", "Tempe bacem": "kedelai",
            "Tahu putih": "kedelai", "Tahu goreng": "kedelai", "Pempek": "ikan;telur",
            "Oatmeal matang": "gluten", "Roti gandum": "gluten", "Roti tawar": "gluten",
            "Pancake": "gluten;telur;susu", "Wafel": "gluten;telur;susu",
            "Pizza keju": "gluten;susu", "Spaghetti bolognese": "gluten;telur",
            "Mac and cheese": "gluten;susu", "Burger sapi": "gluten;telur",
            "Salmon panggang": "ikan", "Sushi salmon": "ikan", "Ramen": "gluten;telur",
            "Burrito ayam": "gluten", "Taco daging": "gluten", "Hummus": "kacang",
            "Falafel": "kacang", "Keju cheddar": "susu", "Yoghurt tawar": "susu",
            "Susu sapi": "susu", "Susu kedelai tawar": "kedelai", "Puding vanila": "susu;telur",
            "Es krim vanila": "susu;telur", "Donat gula": "gluten;telur;susu",
            "Biskuit asin": "gluten", "Kacang panggang tanpa garam": "kacang",
            "Edamame rebus": "kedelai", "Tahu kukus": "kedelai", "Udang asam manis": "udang"
        }
        cur.executemany("UPDATE makanan SET alergen = ? WHERE nama = ?", [(value, name) for name, value in tags.items()])
        con.commit()
    finally:
        con.close()

intents = discord.Intents.default()
intents.message_content = True

bot = commands.Bot(command_prefix="!", intents=intents)


def get_recommendations(
    rasa="any",
    jenis="any",
    max_calories=None,
    avoided_allergens=None
):
    con = sqlite3.connect(DB_PATH)

    try:
        cur = con.cursor()

        query = """
            SELECT
                nama,
                jenis,
                rasa,
                kalori_per_100g,
                protein_g,
                karbohidrat_g,
                lemak_g,
                kategori_gizi,
                sumber_data,
                catatan
            FROM makanan
            WHERE 1 = 1
        """

        params = []

        # Filter rasa
        if rasa != "any":
            query += " AND LOWER(rasa) LIKE ?"
            params.append(f"%{rasa.lower()}%")

        # Filter jenis makanan
        if jenis != "any":
            query += " AND LOWER(jenis) LIKE ?"
            params.append(f"%{jenis.lower()}%")

        # Filter kalori opsional per 100 g
        if max_calories is not None:
            query += " AND kalori_per_100g <= ?"
            params.append(max_calories)

        for allergen in avoided_allergens or []:
            query += " AND (';' || LOWER(alergen) || ';') NOT LIKE ?"
            params.append(f"%;{allergen.lower()};%")

        query += " ORDER BY RANDOM() LIMIT 5"

        cur.execute(query, params)
        return cur.fetchall()

    finally:
        con.close()


FOOD_TYPES = ("makanan pokok", "makanan berat", "sup", "salad")


