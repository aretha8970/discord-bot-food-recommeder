@bot.command()
async def rekomendasi(ctx):

    def check(message):
        return (
            message.author == ctx.author
            and message.channel == ctx.channel
        )

    async with ctx.typing():

        try:


            await ctx.send(
                " **Rasa apa yang Anda inginkan?**\n"
                "Ketik salah satu:\n"
                "`gurih`, `asin`, `manis`, `pedas`, "
                "`asam`, atau `any`"
            )

            msg = await bot.wait_for(
                "message",
                check=check,
                timeout=60
            )

            rasa = msg.content.strip().lower()

            allowed_tastes = [
                "gurih", "asin", "manis",
                "pedas", "asam", "any"
            ]

            if rasa not in allowed_tastes:
                await ctx.send(
                    "❌ Rasa tidak valid. Silakan jalankan "
                    "`!rekomendasi` lagi."
                )
                return


            await ctx.send(
                "**Jenis makanan apa yang Anda inginkan?**\n"
                "`Makanan pokok`, `Makanan berat`, `Sup`, `Salad`, atau `any`"
            )

            msg = await bot.wait_for(
                "message",
                check=check,
                timeout=60
            )

            jenis = msg.content.strip()

            allowed_types = set(FOOD_TYPES) | {"any"}

            if jenis.lower() not in allowed_types:
                await ctx.send(
                    "❌ Jenis makanan tidak valid. Silakan jalankan "
                    "`!rekomendasi` lagi."
                )
                return

            jenis = jenis.lower()


            await ctx.send(
                "**Preferensi gizi**\n"
                "Masukkan batas maksimal kalori per 100 g, "
                "atau ketik `any` untuk melewati filter.\n"
                "Contoh: `200` atau `any`"
            )

            msg = await bot.wait_for(
                "message",
                check=check,
                timeout=60
            )

            calorie_input = msg.content.strip().lower()

            if calorie_input == "any":
                max_calories = None

            else:
                try:
                    max_calories = float(calorie_input)

                    if not 0 < max_calories <= 1000:
                        raise ValueError

                except ValueError:
                    await ctx.send(
                        "❌ Masukkan angka antara 1 dan "
                        "1000, atau ketik `any`."
                    )
                    return

            await ctx.send(
                "⚠️ **Filter alergi**\n"
                "Ketik alergen yang ingin dihindari, pisahkan dengan koma, atau ketik `tidak ada`.\n"
                "Pilihan: `susu`, `telur`, `kacang`, `kedelai`, `gluten`, `ikan`, `udang`\n"
                "Contoh: `susu, telur`"
            )

            msg = await bot.wait_for("message", check=check, timeout=60)
            allergy_input = msg.content.strip().lower()
            avoided_allergens = [] if allergy_input in {"none", "tidak ada", "any"} else [
                item.strip() for item in allergy_input.split(",") if item.strip()
            ]

            invalid_allergens = set(avoided_allergens) - ALERGENS
            if invalid_allergens:
                await ctx.send(
                    "❌ Alergen tidak dikenal: "
                    f"`{', '.join(sorted(invalid_allergens))}`. Jalankan `!rekomendasi` lagi."
                )
                return


            await ctx.send("Mencari rekomendasi makanan...")

            results = get_recommendations(
                rasa=rasa,
                jenis=jenis,
                max_calories=max_calories,
                avoided_allergens=avoided_allergens
            )

            if not results:
                await ctx.send(
                    " Tidak ada makanan yang sesuai.\n"
                    "Coba ubah rasa, jenis makanan, preferensi gizi, atau filter alergi."
                )
                return


            embed = discord.Embed(
                title="Rekomendasi Makanan Anda",
                description=(
                    "Berikut makanan dari basis data Anda!\n"
                    "⚠️ Tag alergen mengikuti resep umum; selalu periksa bahan makanan yang sebenarnya."
                ),
                color=discord.Color.orange()
            )

            for food in results:
                (
                    nama,
                    food_type,
                    taste,
                    calories,
                    protein,
                    carbs,
                    fat,
                    category,
                    source,
                    notes
                ) = food

                embed.add_field(
                    name=f" {nama}",
                    value=(
                        f"**Jenis:** {food_type}\n"
                        f"**Rasa:** {taste}\n"
                        f"**Kalori:** {calories:g} kkal/100 g\n"
                        f"**Protein:** {protein:g} g/100 g\n"
                        f"**Karbohidrat:** {carbs:g} g/100 g\n"
                        f"**Lemak:** {fat:g} g/100 g\n"
                        f"**Kategori gizi:** {category}"
                    ),
                    inline=False
                )

            embed.set_footer(
                text=(
                    "Nilai gizi adalah perkiraan per 100 g. "
                    "Nilai sebenarnya dapat berbeda."
                )
            )

            await ctx.send(embed=embed)

        except TimeoutError:
            await ctx.send(
                "Waktu habis! Jalankan `!rekomendasi` "
                "saat Anda siap mencoba lagi."
            )

        except sqlite3.Error as error:
            print(f"Kesalahan basis data: {error}")
            await ctx.send(
                "❌ Terjadi kesalahan saat membaca "
                "basis data makanan."
            )

bot.run(TOKEN)
